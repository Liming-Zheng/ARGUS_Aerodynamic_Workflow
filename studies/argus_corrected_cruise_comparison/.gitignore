*.py[cod]

# VSPAERO regenerates these solver sidecars from the retained .vsp3 files.
outputs/**/model/*
!outputs/**/model/*.vsp3

# Per-case VSPAERO solver sidecars and verbose worker logs.
outputs/**/*.adb
outputs/**/*.adb.cases
outputs/**/*.csf
outputs/**/*.group.*
outputs/**/*.history
outputs/**/*.lod
outputs/**/*.polar
outputs/**/*.vkey
outputs/**/*.vspaero
outputs/**/*.vspgeom
outputs/**/evaluation.log
outputs/**/*.log
outputs/**/*.pid
