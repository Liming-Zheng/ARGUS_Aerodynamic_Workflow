{
  "run_name": "corrected_te_cdi",
  "case_prefix": "cte",
  "sample_filter": {
    "case_id_prefixes": [
      "cte_"
    ]
  },
  "random_seed": 20260729,
  "paths": {
    "optimization_root": "outputs/corrected_te_optimization",
    "baseline_model": "outputs/tyler_validation_2026_07_29/baseline_corrected/baseline_corrected.vsp3",
    "solver_config": "config/corrected_te_solver_config.json"
  },
  "design_variables": {
    "control_etas": [
      0.6,
      0.7,
      0.8,
      0.9,
      1.0
    ],
    "amplitude_bounds_over_c": [
      0.0,
      0.035
    ],
    "max_adjacent_delta": 0.018,
    "include_boundary_zeros_in_adjacent_delta": true,
    "x_h_over_c": 0.62,
    "eta_start": 0.6,
    "eta_end": 1.0
  },
  "objective": {
    "metric": "CDi",
    "direction": "minimize",
    "root_bending_weight": 0.0,
    "torque_weight": 0.0,
    "endpoint_weight": 0.0,
    "curvature_weight": 0.0
  },
  "constraints": {
    "root_bending": {
      "enabled": true,
      "maximum_percent": 6.8,
      "penalty": 800.0
    },
    "hinge_torque_proxy": {
      "enabled": false,
      "status": "withdrawn"
    }
  },
  "algorithm": {
    "name": "differential_evolution",
    "population_size": 12,
    "inner_max_iterations": 70,
    "tolerance": 1e-07,
    "polish": true,
    "random_search_samples": 100000,
    "minimum_candidate_distance": 0.003
  },
  "surrogate": {
    "optimizer_restarts": 4,
    "exploration_weight": 0.15
  },
  "iterations": {
    "max_iterations": 2,
    "batch_size": 4,
    "minimum_absolute_improvement": 5e-07,
    "early_stop_patience": 2
  },
  "runtime": {
    "workers": 4,
    "trim_mode": "fast",
    "fast_trim_alpha_low": 0.8,
    "fast_trim_alpha_high": 2.2,
    "fast_trim_alpha_points": 2,
    "search_cl_tolerance": 0.0002,
    "openvsp_python": "${OPENVSP_PYTHON}",
    "general_python": "${GENERAL_PYTHON}"
  },
  "notes": [
    "Independent optimization on corrected inserted-airfoil baseline.",
    "Pure CDi objective with illustrative root-bending and smoothness screens.",
    "No hinge-moment constraint."
  ]
}


