{
  "run_name": "whole_wing_cdi_sanity",
  "case_prefix": "wsu",
  "random_seed": 20260618,
  "sample_filter": {
    "case_id_prefixes": ["wsc_", "wsu_"]
  },
  "design_variables": {
    "control_etas": [0.0, 0.25, 0.5, 0.75, 1.0],
    "amplitude_bounds_over_c": [0.0, 0.04],
    "max_adjacent_delta": 1.0,
    "include_boundary_zeros_in_adjacent_delta": false,
    "x_h_over_c": 0.62,
    "eta_start": 0.0,
    "eta_end": 1.0
  },
  "objective": {
    "metric": "CDi",
    "direction": "minimize",
    "root_bending_weight": 0.0,
    "torque_weight": 0.0,
