      <CustomGeom>
        <Length Value="1.710000000000000000e+000" ID="JKMARJGRTDN"/>
        <Inboard_DX Value="-1.775460000000000100e-001" ID="UTNLSPIYQJQ"/>
        <Inboard_DZ Value="-1.333449999999999900e-001" ID="VFOTDIJRHCT"/>
        <Outboard_DX Value="-1.481619999999999900e-001" ID="TCCLTYQBTHW"/>
