      <CustomGeom>
        <Length Value="1.710000000000000000e+000" ID="FNJCRQOZJVO"/>
        <Inboard_DX Value="1.754159999999999900e-001" ID="USPVPOIGFAE"/>
        <Inboard_DZ Value="-1.020400000000000000e-002" ID="RHTQHQWIQBW"/>
        <Outboard_DX Value="1.786290000000000100e-001" ID="UOULQOVSTRW"/>
