        <ScriptFileModule>FlapTrack</ScriptFileModule>
        <ScriptFileContents>
//==== Init Is Called Once During Each Custom Geom Construction  ============================//
//==== Avoid Global Variables Unless You Want Shared With All Custom Geoms of This Type =====//
void Init()
{
	//==== Set Up Parms in the Design Tab  =====//
	string length = AddParm( PARM_DOUBLE_TYPE, "Length", "Design" );
	SetParmValLimits( length, 1.0, -1.0e12, 1.0e12 );
    	SetParmDescript( length, "Length of reference line" );

	//==== Set Up Parms in the Deflect Tab  =====//
	string dx_in = AddParm( PARM_DOUBLE_TYPE, "Inboard_DX", "Deflect" );
	string dz_in = AddParm( PARM_DOUBLE_TYPE, "Inboard_DZ", "Deflect" );
	SetParmValLimits( dx_in, 0.0, -1.0e12, 1.0e12 );
	SetParmValLimits( dz_in, 0.0, -1.0e12, 1.0e12 );
    	SetParmDescript( dx_in, "Inboard x translation" );
    	SetParmDescript( dz_in, "Inboard z translation" );
	
	string dx_out = AddParm( PARM_DOUBLE_TYPE, "Outboard_DX", "Deflect" );
	string dz_out = AddParm( PARM_DOUBLE_TYPE, "Outboard_DZ", "Deflect" );
	SetParmValLimits( dx_out, 0.0, -1.0e12, 1.0e12 );
	SetParmValLimits( dz_out, 0.0, -1.0e12, 1.0e12 );
    	SetParmDescript( dx_out, "Outboard x translation" );
    	SetParmDescript( dz_out, "Outboard z translation" );

	//==== Add Fixed Cross Sections  =====//
	string xsec_surf0 = AddXSecSurf();
	string xsec_surf1 = AddXSecSurf();

	string xsec00 = AppendCustomXSec( xsec_surf0, XS_CIRCLE);
	string xsec01 = AppendCustomXSec( xsec_surf0, XS_CIRCLE);
	string xsec10 = AppendCustomXSec( xsec_surf1, XS_CIRCLE);
	string xsec11 = AppendCustomXSec( xsec_surf1, XS_CIRCLE);

	SetParmVal( GetXSecParm( xsec00, "Circle_Diameter" ), 0.01 );
	SetParmVal( GetXSecParm( xsec01, "Circle_Diameter" ), 0.01 );
	SetParmVal( GetXSecParm( xsec10, "Circle_Diameter" ), 0.01 );
	SetParmVal( GetXSecParm( xsec11, "Circle_Diameter" ), 0.01 );

	SetCustomXSecRot( xsec00, vec3d(0.0, 0.0, 90.0) );
	SetCustomXSecRot( xsec01, vec3d(0.0, 0.0, 90.0) );
	SetCustomXSecRot( xsec10, vec3d(0.0, 0.0, 90.0) );
	SetCustomXSecRot( xsec11, vec3d(0.0, 0.0, 90.0) );

	//==== Set Default Tess Vals ====//
	string geom_id = GetCurrCustomGeom();
	SetParmVal( GetParm( geom_id, "Tess_U",  "Shape" ), 2 );
	SetParmVal( GetParm( geom_id, "Tess_W",  "Shape" ), 9 );
}

//==== InitGui Is Called Once During Each Custom Geom Construction ====//
void InitGui()
{
	//==== Create Design Tab ====//
	AddGui( GDEV_TAB, "Design"  );
	AddGui( GDEV_YGAP );
	AddGui( GDEV_SLIDER_ADJ_RANGE_INPUT, "Length", "Length", "Design" );

	//==== Create Deflect Tab ====//
	AddGui( GDEV_TAB, "Deflect"  );
	AddGui( GDEV_YGAP );
	AddGui( GDEV_DIVIDER_BOX, "Inboard" );
	AddGui( GDEV_SLIDER_ADJ_RANGE_INPUT, "Delta X", "Inboard_DX", "Deflect" );
	AddGui( GDEV_SLIDER_ADJ_RANGE_INPUT, "Delta Z", "Inboard_DZ", "Deflect" );
	AddGui( GDEV_DIVIDER_BOX, "Outboard" );
	AddGui( GDEV_SLIDER_ADJ_RANGE_INPUT, "Delta X", "Outboard_DX", "Deflect" );
	AddGui( GDEV_SLIDER_ADJ_RANGE_INPUT, "Delta Z", "Outboard_DZ", "Deflect" );

	//==== Disconnect XForm Sliders From Parms ====//
//	UpdateGui( XLocSlider, GetParm( geom_id, "", "XForm" ) );
//	UpdateGui( YLocSlider, GetParm( geom_id, "", "XForm" ) );
//	UpdateGui( ZLocSlider, GetParm( geom_id, "", "XForm" ) );
} 

//==== UpdateGui Is Called Every Time The Gui is Updated ====//
void UpdateGui()
{
}

//==== UpdateSurf Is Called Every Time The Geom is Updated ====//
void UpdateSurf()
{
	string geom_id = GetCurrCustomGeom();

	//==== Get Curr Parm Vals ====//
	double length  = GetParmVal( GetParm( geom_id, "Length",  "Design" ) );

	double dx_in  = GetParmVal( GetParm( geom_id, "Inboard_DX",  "Deflect" ) );
	double dz_in  = GetParmVal( GetParm( geom_id, "Inboard_DZ",  "Deflect" ) );
	double dx_out = GetParmVal( GetParm( geom_id, "Outboard_DX", "Deflect" ) );
	double dz_out = GetParmVal( GetParm( geom_id, "Outboard_DZ", "Deflect" ) );

        const double R2D = 57.29577951308;
        double dx_new = dx_out - dx_in;
        double dz_new = dz_out - dz_in;
        double dy_in  = 0.5 * (length - sqrt(length*length - dx_new*dx_new - dz_new*dz_new));
        double dy_new = length - 2.0 * dy_in;
        double span_new = sqrt(dy_new*dy_new + dz_new*dz_new);
        double dihed = asin(dz_new / span_new);
        double sweep = atan(dx_new / span_new);
        double xloc = dx_in;
        double yloc = dy_in;
        double zloc = dz_in;
        double xrot = dihed * R2D;
        double yrot = 0.0;
        double zrot = -sweep * R2D;

	//==== Set the XForm Parms ====//
	SetParmVal( GetParm( geom_id, "X_Rel_Location",  "XForm" ), xloc );
	SetParmVal( GetParm( geom_id, "Y_Rel_Location",  "XForm" ), yloc );
	SetParmVal( GetParm( geom_id, "Z_Rel_Location",  "XForm" ), zloc );

	SetParmVal( GetParm( geom_id, "X_Rel_Rotation",  "XForm" ), xrot );
	SetParmVal( GetParm( geom_id, "Y_Rel_Rotation",  "XForm" ), yrot );
	SetParmVal( GetParm( geom_id, "Z_Rel_Rotation",  "XForm" ), zrot );

	//==== Get the XSec Surf ====//
	string xsec_surf0 = GetXSecSurf( geom_id, 0 );
	string xsec_surf1 = GetXSecSurf( geom_id, 1 );

	//==== Define the First/Last XSec Placement ====//
	string xsec00 = GetXSec( xsec_surf0, 0 );
	string xsec01 = GetXSec( xsec_surf0, 1 );
	string xsec10 = GetXSec( xsec_surf1, 0 );
	string xsec11 = GetXSec( xsec_surf1, 1 );
	SetCustomXSecLoc( xsec00, vec3d( 0.0,           0.0, 0.0 ) );
	SetCustomXSecLoc( xsec01, vec3d( 0.0,        0.0001, 0.0 ) );
	SetCustomXSecLoc( xsec10, vec3d( 0.0, length-0.0001, 0.0 ) );
	SetCustomXSecLoc( xsec11, vec3d( 0.0,        length, 0.0 ) );

	SkinXSecSurf();
}
</ScriptFileContents>
