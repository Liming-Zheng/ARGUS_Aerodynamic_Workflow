      <CustomGeom>
        <Length Value="1.710000000000000000e+000" ID="JBXMIIEWWXT"/>
        <Inboard_DX Value="2.699899999999999900e-002" ID="EIARZRLEBTM"/>
        <Inboard_DZ Value="-1.283400000000000000e-002" ID="UYFQBSPFISR"/>
        <Outboard_DX Value="3.001699999999999900e-002" ID="NBYANCCTIIZ"/>
