      <CustomGeom>
        <Length Value="3.516000000000000000e+000" ID="PICRUOFRAQK"/>
        <Inboard_DX Value="-1.400309999999999900e-001" ID="KTCSNRORXRX"/>
        <Inboard_DZ Value="-4.821099999999999700e-002" ID="ENPUZKTCKUR"/>
        <Outboard_DX Value="-8.232000000000000400e-002" ID="UTQRZZTXSVE"/>
